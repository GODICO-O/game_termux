<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.habicode.hostapi">

    <application
        android:label="Host API"
        android:allowBackup="true"
        android:theme="@android:style/Theme.NoDisplay">
        
        <!-- MainActivity agar aplikasi terdaftar sebagai app normal -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver untuk menangkap sinyal dari Termux -->
        <receiver
            android:name=".HostApiReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.habicode.hostapi.SHOW_KEYBOARD" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
