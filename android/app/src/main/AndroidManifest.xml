<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.habicode.hostapi">

    <application
        android:label="HabiCode Host API"
        android:allowBackup="true"
        android:theme="@android:style/Theme.NoDisplay">
        
        <!-- Native Activity utama dari android-activity -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:launchMode="singleTask"
            android:exported="true">
            
            <meta-data android:name="android.app.lib_name" android:value="host_api" />
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver untuk menangkap perintah dari Termux -->
        <receiver
            android:name=".HostApiReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.habicode.hostapi.SHOW_KEYBOARD" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
